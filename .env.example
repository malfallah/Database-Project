# Copy to .env to override the defaults in docker-compose.yml.
# .env is git-ignored; never commit real credentials.

POSTGRES_USER=safehands
POSTGRES_PASSWORD=change-me
POSTGRES_DB=safe_hands
# Host port for the database (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# Used by `npm test` and `npm run scenario` to target the Docker database
# instead of the in-process PGlite one. Export it in your shell, e.g.
#   export DATABASE_URL=postgres://safehands:change-me@localhost:5432/safe_hands
DATABASE_URL=postgres://safehands:change-me@localhost:5432/safe_hands
